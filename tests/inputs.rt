# V6: Rayleigh–Taylor, Tryggvason 1988 setup as restated in Guermond–Salgado 2009 §5.2
# d = 1, g = 1, rho_min = 1 -> time unit sqrt(d/g) = 1; Tryggvason time t_T = t*sqrt(At), At = 0.5 -> t = t_T/0.7071
# heavy fluid (rho 3) above: phi > 0 above the interface -> rho_w = 3 ; Re = rho_min d^{3/2} g^{1/2} / mu = 1000 -> mu = 1e-3
prob.flow = 1
prob.type = rt
geometry.prob_lo = -0.5 -2.0
geometry.prob_hi =  0.5  2.0
geometry.is_periodic = 1 0
ns.lo_bc = 0 5
ns.hi_bc = 0 5
amr.n_cell = 64 256
prob.perturbation_amplitude = 0.1
prob.interface_y = 0.0
ns.do_phi = 1
ns.rho_w = 3.0
ns.rho_a = 1.0
ns.mu_w = 1e-3
ns.mu_a = 1e-3
ns.gravity = -1.0
ns.cfl = 0.5
ns.init_iter = 3
ns.epsilon = 2
ns.number_of_reinit = 4
reinit.alpha_delta = 1
stop_time = 3.5355
diag.interval = 10
amr.plot_int = 100
lin.rtol = 1e-9
out_dir = out/rt64
