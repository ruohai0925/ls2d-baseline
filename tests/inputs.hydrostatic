# V5: flat interface at rest under gravity, density ratio 1000:1 (heavy fluid below: rho_a below? here phi>0 above -> rho_w = light upper fluid)
prob.flow = 1
prob.type = hydrostatic
geometry.prob_lo = 0 0
geometry.prob_hi = 1 1
geometry.is_periodic = 1 0
ns.lo_bc = 0 4
ns.hi_bc = 0 4
amr.n_cell = 64 64
ns.do_phi = 1
prob.interface_y = 0.5
ns.rho_w = 1.0
