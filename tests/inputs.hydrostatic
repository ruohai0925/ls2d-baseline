ns.mu_w = 1e-5
ns.mu_a = 1e-3
ns.gravity = -9.81
ns.cfl = 0.5
ns.init_iter = 3
ns.epsilon = 2
stop_time = 0.5
diag.interval = 10
out_dir = out/hydro64
