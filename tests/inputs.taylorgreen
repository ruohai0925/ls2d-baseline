# Taylor–Green decaying vortex, periodic unit box, nu = mu/rho = 0.01 (docs/results.md §1)
prob.type = taylorgreen
geometry.prob_lo = 0 0
geometry.prob_hi = 1 1
geometry.is_periodic = 1 1
amr.n_cell = 64 64
ns.rho = 1.0
ns.mu = 0.01
ns.cfl = 0.5
ns.init_iter = 3
stop_time = 0.2
diag.interval = 10
amr.plot_int = 0
lin.rtol = 1e-11
out_dir = out/tg64
