# V3: single vortex with time reversal, Enright 2002 §3.2 (T = 8)
prob.type = vortex
geometry.prob_lo = 0 0
geometry.prob_hi = 1 1
geometry.is_periodic = 0 0
amr.n_cell = 128 128
prob.blob_x = 0.5
prob.blob_y = 0.75
prob.blob_radius = 0.15
prob.reverse_period = 8
stop_time = 8
ns.cfl = 0.5
ns.do_reinit = 1
ns.number_of_reinit = 4
ns.epsilon = 2
diag.nsub = 10
diag.interval = 20
amr.plot_int = 200
out_dir = out/vortex128
