# V8: Hysing et al. 2009 rising bubble, test case 1 (Re 35, Eo 10): bubble = phi>0 fluid (rho_w, mu_w), liquid = rho_a, mu_a
prob.flow = 1
prob.type = bubble
geometry.prob_lo = 0 0
geometry.prob_hi = 1 2
geometry.is_periodic = 0 0
ns.lo_bc = 4 5
ns.hi_bc = 4 5
amr.n_cell = 80 160
prob.blob_x = 0.5
prob.blob_y = 0.5
prob.blob_radius = 0.25
ns.do_phi = 1
ns.rho_w = 100.0
ns.rho_a = 1000.0
ns.mu_w = 1.0
ns.mu_a = 10.0
ns.sigma = 24.5
ns.gravity = -0.98
ns.cfl = 0.5
ns.init_iter = 3
ns.epsilon = 2
reinit.alpha_delta = 1
stop_time = 3.0
diag.interval = 10
amr.plot_int = 200
out_dir = out/hysing1_80
